<PackageFile xmlns="http://www.ccsds.org/schema/sois/seds">
  <Package name="@TEMPLATE@" shortDescription="Sample Application Package">

    <DataTypeSet>

      <ContainerDataType name="ExampleParam_Payload" shortDescription="Example Command with a payload/argument">
        <EntryList>
          <Entry name="ValI16" type="BASE_TYPES/int16" shortDescription="16 bit signed integer value" />
        </EntryList>
      </ContainerDataType>

      <ContainerDataType name="HkTlm_Payload" shortDescription="Sample App Housekeeping Content">
        <EntryList>
          <Entry name="CommandCounter"      type="BASE_TYPES/uint8" />
          <Entry name="CommandErrorCounter" type="BASE_TYPES/uint8" />
          <Entry name="ExampleCmdParam"     type="BASE_TYPES/int16" shortDescription="Example command parameter" />          
        </EntryList>
      </ContainerDataType>

      <ContainerDataType name="SendHkCmd" baseType="CFE_HDR/CommandHeader">
      </ContainerDataType>

      <ContainerDataType name="CommandBase" baseType="CFE_HDR/CommandHeader">
      </ContainerDataType>

      <ContainerDataType name="HkTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry type="HkTlm_Payload" name="Payload" />
        </EntryList>
      </ContainerDataType>

      <ContainerDataType name="NoopCmd" baseType="CommandBase">
        <ConstraintSet>
          <ValueConstraint entry="Sec.FunctionCode" value="0" />
        </ConstraintSet>
      </ContainerDataType>

      <ContainerDataType name="ResetCountersCmd" baseType="CommandBase">
        <ConstraintSet>
          <ValueConstraint entry="Sec.FunctionCode" value="1" />
        </ConstraintSet>
      </ContainerDataType>

      <ContainerDataType name="ExampleParamCmd" baseType="CommandBase">
        <ConstraintSet>
          <ValueConstraint entry="Sec.FunctionCode" value="2" />
        </ConstraintSet>
        <EntryList>
          <Entry type="ExampleParam_Payload" name="Payload" />
        </EntryList>
      </ContainerDataType>
      <!-- EX1,10,13, -->
      <!-- Note the type name here must be "ExampleTable" to match the C table definition file,
           but the source code uses the type "ExampleTable" -->
      <ContainerDataType name="ExampleTable" shortDescription="Example ExampleTable structure">
        <EntryList>
          <Entry name="Int1" type="BASE_TYPES/uint16" />
          <Entry name="Int2" type="BASE_TYPES/uint16" />
        </EntryList>
      </ContainerDataType>
      
      <ContainerDataType name="TblFile_Payload" shortDescription="BC: Table proxy telemetry payload">
        <EntryList>
          <Entry name="FileHdr" type="CFE_FS/Header"    shortDescription="cFE standard file header" />
          <Entry name="TblHdr"  type="CFE_TBL/File_Hdr" shortDescription="cFE standard table header" />
          <Entry name="TblData" type="ExampleTable"     shortDescription="" />
        </EntryList>
      </ContainerDataType>
      
      <ContainerDataType name="TblFile" baseType="CFE_HDR/TelemetryHeader" shortDescription="BC: Table proxy telemetry payload">
        <EntryList>
          <Entry type="TblFile_Payload" name="Payload" shortDescription="TblFile_Payload"/>
        </EntryList>
      </ContainerDataType>      
    </DataTypeSet>
    <!-- EX1 -->
    <ComponentSet>
      <Component name="Application">
        <RequiredInterfaceSet>
          <Interface name="ExampleTable" shortDescription="Table interface" type="CFE_TBL/Table">
            <GenericTypeMapSet>
              <GenericTypeMap name="TableDataType" type="ExampleTable" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="CMD" shortDescription="Software bus telecommand interface" type="CFE_SB/Telecommand">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelecommandDataType" type="CommandBase" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="SEND_HK" shortDescription="Send telemetry command interface" type="CFE_SB/Telecommand">
            <!-- This uses a bare spacepacket with no payload -->
            <GenericTypeMapSet>
              <GenericTypeMap name="TelecommandDataType" type="SendHkCmd" />
            </GenericTypeMapSet>
          </Interface>
          <!-- EX2,6,5, -->
          <Interface name="HK_TLM" shortDescription="Software bus housekeeping telemetry interface" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="HkTlm" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="TBL_PROXY_TLM" shortDescription="BC: Proxy telemetry for Example Table File" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="TblFile" />
            </GenericTypeMapSet>
          </Interface>          
        </RequiredInterfaceSet>
        <!-- EX2 -->        
        <!-- EX3,6,8, -->
        <Implementation>
          <VariableSet>
            <Variable type="BASE_TYPES/uint16" readOnly="true" name="CmdTopicId" initialValue="${CFE_MISSION/@TEMPLATE@_CMD_TOPICID}" />
            <Variable type="BASE_TYPES/uint16" readOnly="true" name="SendHkTopicId" initialValue="${CFE_MISSION/@TEMPLATE@_SEND_HK_TOPICID}" />
            <Variable type="BASE_TYPES/uint16" readOnly="true" name="HkTlmTopicId" initialValue="${CFE_MISSION/@TEMPLATE@_HK_TLM_TOPICID}" />
            <Variable type="BASE_TYPES/uint16" readOnly="true" name="TblProxyTlmTopicId" initialValue="${CFE_MISSION/@TEMPLATE@_TBL_PROXY_TLM_TOPICID}" shortDescription="BC: Table proxy telemetry"/>
          </VariableSet>
          <!-- Assign fixed numbers to the "TopicId" parameter of each interface -->
          <ParameterMapSet>
            <ParameterMap interface="CMD" parameter="TopicId" variableRef="CmdTopicId" />
            <ParameterMap interface="SEND_HK" parameter="TopicId" variableRef="SendHkTopicId" />
            <ParameterMap interface="HK_TLM" parameter="TopicId" variableRef="HkTlmTopicId" />
            <ParameterMap interface="TBL_PROXY_TLM" parameter="TopicId" variableRef="TblProxyTlmTopicId" shortDescription="BC: Table proxy telemetry"/>
          </ParameterMapSet>
        </Implementation>
        <!-- EX3 -->
      </Component>
    </ComponentSet>

  </Package>
</PackageFile>
<!-- EX4,1, -->
These are special target build instructions for this lesson. This lesson is
unique because the NASA_TABLE app needs to be reinstalled before the target
is rebuilt. This is achieved by

1. Select "File->Remove User App" from Target"
   - Select nasa_table app
   - Select option to not remove source files

2. Select "File->Add User App to Target"
   - Select nasa_table and select the green buttons to install the app,
     rebuild the target and restart the GUI. 

The app is reinstalled because this lesson added a Topic ID for the table
proxy telemetry message. See the NASA_TABLE Tutorial Document for more details. 
<!-- EX4 -->
